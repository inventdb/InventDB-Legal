# ---------------------------------------------------------------------------
# InventDB Legal - Backend configuration
# Copy this file to ".env" and fill in your own values.
# ---------------------------------------------------------------------------

# Base URL of your InventDB instance (no trailing slash).
# For a sandbox this looks like: https://<slug>.sandbox.inventdb.com
# Register / create yours at https://www.inventdb.com
INVENTDB_BASE_URL=https://b0eb30d6.sandbox.inventdb.com

# The namespace (database) inside InventDB that stores all practice data.
# It is created automatically on first write.
INVENTDB_NAMESPACE=legal

# The app label sent to InventDB (used by /api/auth/me?app=...).
INVENTDB_APP=legal

# Comma-separated list of origins allowed to call this API (the frontend URL).
# Use * only for local development.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Host / port for the API server.
API_HOST=0.0.0.0
# 8010, not 8000: a sibling InventDB app uses 8000, and on Windows both
# servers can hold the same port without either erroring.
API_PORT=8010

# Outbound request timeout (seconds) when talking to InventDB.
INVENTDB_TIMEOUT=30

# Idle gap (seconds) allowed between chunks of an Analyze agent stream. This is
# NOT a total budget for a turn: the agent can reason for minutes without
# emitting anything, so it only catches a genuinely dead connection.
INVENTDB_STREAM_TIMEOUT=600
